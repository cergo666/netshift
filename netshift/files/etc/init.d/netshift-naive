#!/bin/sh /etc/rc.common
# The NaiveProxy clients of NetShift: one `naive` per link, each a local SOCKS5
# server for sing-box. Started and stopped by NetShift (not enabled at boot): the
# list in /tmp/netshift-naive.list is written by the configuration builder.

USE_PROCD=1
START=96

NAIVE_LIST_FILE="/tmp/netshift-naive.list"

start_service() {
    local binary port proxy_url

    [ -s "$NAIVE_LIST_FILE" ] || return 0
    binary="$(command -v naive 2> /dev/null)"
    [ -n "$binary" ] || binary="$(ls /usr/bin/naive /usr/bin/naiveproxy /opt/bin/naive 2> /dev/null | sed -n '1p')"
    [ -n "$binary" ] || {
        logger -t netshift-naive "the naive client is not installed"
        return 1
    }

    while IFS='|' read -r port proxy_url; do
        [ -n "$port" ] && [ -n "$proxy_url" ] || continue
        procd_open_instance "naive-$port"
        procd_set_param command "$binary" "--listen=socks://127.0.0.1:$port" "--proxy=$proxy_url"
        procd_set_param respawn 3600 5 0
        procd_set_param stderr 1
        procd_close_instance
    done < "$NAIVE_LIST_FILE"
}
